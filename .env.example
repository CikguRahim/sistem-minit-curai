# Salin fail ini kepada ".env" dan isikan nilai sebenar daripada projek Supabase anda.
# Dapatkan nilai ini di: Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# PENTING:
# - HANYA gunakan "anon public" key di sini. JANGAN sekali-kali letakkan
#   "service_role" key dalam fail ini atau dalam mana-mana kod frontend.
# - Fail ".env" tidak boleh dimuat naik ke Git / repositori awam.
#   Pastikan ".env" disenaraikan dalam ".gitignore".
